{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IF97 Calculator",
  "version": "0.1.0",
  "identifier": "com.if97.calculator",
  "build": {
    "beforeDevCommand": "cd ../wasm && trunk serve",
    "beforeBuildCommand": "cd ../wasm && trunk build",
    "devUrl": "http://localhost:8080",
    "frontendDist": "../wasm/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "IF97 Water Properties",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}